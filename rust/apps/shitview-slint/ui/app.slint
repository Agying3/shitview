import { Button, HorizontalBox, ScrollView, VerticalBox } from "std-widgets.slint";

export struct SceneRect {
    x: float,
    y: float,
    width: float,
    height: float,
    fill: color,
    border: color,
}

export struct SceneSegment {
    x: float,
    y: float,
    width: float,
    height: float,
    color: color,
}

export struct SceneLabel {
    x: float,
    y: float,
    text: string,
}

export component AppWindow inherits Window {
    title: "shitview Phase 0";
    preferred-width: 1280px;
    preferred-height: 800px;
    min-width: 960px;
    min-height: 640px;
    background: #111419;

    in property <[SceneRect]> graph-nodes;
    in property <[SceneRect]> graph-modules;
    in property <[SceneSegment]> graph-segments;
    in property <[SceneLabel]> graph-labels;
    in property <float> scene-width: 3200;
    in property <float> scene-height: 2200;
    in property <string> node-metric: "1,000";
    in property <string> primitive-metric: "0";
    in property <string> generation-metric: "0 ms";
    in-out property <float> zoom: 0.72;
    in-out property <float> pulse: 0;

    callback select-density(int);
    callback zoom-in();
    callback zoom-out();

    VerticalBox {
        spacing: 0px;

        Rectangle {
            height: 62px;
            background: #181c23;
            border-color: #323a46;
            border-width: 1px;

            HorizontalBox {
                padding-left: 18px;
                padding-right: 18px;
                spacing: 12px;
                alignment: center;

                Image {
                    width: 34px;
                    height: 34px;
                    source: @image-url("../../../../resouce/shitview.jpg");
                    image-fit: cover;
                }

                VerticalBox {
                    width: 168px;
                    spacing: 1px;
                    alignment: center;
                    Text {
                        text: "shitview";
                        color: #f3f6fb;
                        font-family: "Microsoft YaHei UI";
                        font-size: 18px;
                        font-weight: 700;
                    }
                    Text {
                        text: "RUST / SLINT";
                        color: #6f8095;
                        font-size: 10px;
                    }
                }

                Rectangle { horizontal-stretch: 1; background: transparent; }

                Text { text: "DENSITY"; color: #718197; font-size: 10px; }
                Button { text: "1K"; clicked => { root.select-density(1000); } }
                Button { text: "5K"; clicked => { root.select-density(5000); } }
                Button { text: "10K"; clicked => { root.select-density(10000); } }

                Rectangle { width: 10px; background: transparent; }
                Button { text: "-"; clicked => { root.zoom-out(); } }
                Text {
                    width: 54px;
                    horizontal-alignment: center;
                    text: round(root.zoom * 100) + "%";
                    color: #c9d3df;
                    font-size: 12px;
                }
                Button { text: "+"; clicked => { root.zoom-in(); } }
            }
        }

        HorizontalBox {
            spacing: 0px;

            Rectangle {
                width: 228px;
                background: #15191f;
                border-color: #2b323d;
                border-width: 1px;

                VerticalBox {
                    padding: 18px;
                    spacing: 16px;

                    Text { text: "SCENE"; color: #718197; font-size: 10px; font-weight: 700; }

                    VerticalBox {
                        spacing: 4px;
                        Text { text: root.node-metric; color: #f0f5fb; font-size: 30px; font-weight: 700; }
                        Text { text: "visible nodes"; color: #8290a2; font-size: 11px; }
                    }

                    Rectangle { height: 1px; background: #2b323d; }

                    VerticalBox {
                        spacing: 8px;
                        HorizontalBox {
                            Text { text: "Primitives"; color: #7f8c9d; font-size: 11px; }
                            Rectangle { horizontal-stretch: 1; background: transparent; }
                            Text { text: root.primitive-metric; color: #c7d2df; font-size: 11px; }
                        }
                        HorizontalBox {
                            Text { text: "Generated"; color: #7f8c9d; font-size: 11px; }
                            Rectangle { horizontal-stretch: 1; background: transparent; }
                            Text { text: root.generation-metric; color: #61eaa3; font-size: 11px; }
                        }
                    }

                    Rectangle { height: 1px; background: #2b323d; }

                    VerticalBox {
                        spacing: 8px;
                        Text { text: "LAYERS"; color: #718197; font-size: 10px; font-weight: 700; }
                        Text { text: "Structure"; color: #d3dbe5; font-size: 12px; }
                        Text { text: "Dependencies"; color: #798697; font-size: 12px; }
                        Text { text: "Activity"; color: #798697; font-size: 12px; }
                        Text { text: "Labels"; color: #798697; font-size: 12px; }
                    }

                    Rectangle { vertical-stretch: 1; background: transparent; }

                    Rectangle {
                        height: 48px;
                        background: #19251f;
                        border-color: #2b6a49;
                        border-width: 1px;
                        border-radius: 5px;
                        HorizontalBox {
                            padding: 10px;
                            spacing: 8px;
                            Rectangle {
                                width: 7px;
                                height: 7px;
                                border-radius: 4px;
                                background: #48e191;
                            }
                            Text { text: "Synthetic scene ready"; color: #9cdbb9; font-size: 11px; }
                        }
                    }
                }
            }

            Rectangle {
                background: #101318;
                clip: true;

                ScrollView {
                    viewport-width: root.scene-width * root.zoom * 1px;
                    viewport-height: root.scene-height * root.zoom * 1px;

                    Rectangle {
                        width: root.scene-width * root.zoom * 1px;
                        height: root.scene-height * root.zoom * 1px;
                        background: #101318;

                        for segment in root.graph-segments: Rectangle {
                            x: segment.x * root.zoom * 1px;
                            y: segment.y * root.zoom * 1px;
                            width: max(1px, segment.width * root.zoom * 1px);
                            height: max(1px, segment.height * root.zoom * 1px);
                            background: segment.color;
                            opacity: 0.70 + root.pulse * 0.20;
                        }

                        for module in root.graph-modules: Rectangle {
                            x: module.x * root.zoom * 1px;
                            y: module.y * root.zoom * 1px;
                            width: module.width * root.zoom * 1px;
                            height: module.height * root.zoom * 1px;
                            background: module.fill;
                            border-color: module.border;
                            border-width: 1px;
                            border-radius: 5px;
                        }

                        for node in root.graph-nodes: Rectangle {
                            x: node.x * root.zoom * 1px;
                            y: node.y * root.zoom * 1px;
                            width: node.width * root.zoom * 1px;
                            height: node.height * root.zoom * 1px;
                            background: node.fill;
                            border-color: node.border;
                            border-width: 1px;
                            border-radius: 3px;
                        }

                        for label in root.graph-labels: Text {
                            x: label.x * root.zoom * 1px;
                            y: label.y * root.zoom * 1px;
                            text: label.text;
                            color: #dbe5ef;
                            font-family: "Microsoft YaHei UI";
                            font-size: max(9px, 13px * root.zoom);
                            font-weight: 600;
                        }
                    }
                }
            }
        }
    }
}
