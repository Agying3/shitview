import { Button, HorizontalBox, LineEdit, VerticalBox } from "std-widgets.slint";

export struct SceneRect {
    x: float,
    y: float,
    width: float,
    height: float,
    fill: color,
    border: color,
}

export struct SceneSegment {
    x: float,
    y: float,
    width: float,
    height: float,
    color: color,
}

export struct SceneLabel {
    x: float,
    y: float,
    width: float,
    text: string,
    always-visible: bool,
}

export component AppWindow inherits Window {
    title: "shitview";
    preferred-width: 1280px;
    preferred-height: 800px;
    min-width: 960px;
    min-height: 640px;
    background: #11161b;

    in property <[SceneRect]> graph-nodes;
    in property <[SceneRect]> graph-modules;
    in property <[SceneSegment]> graph-segments;
    in property <[SceneLabel]> graph-labels;
    in property <image> graph-image;
    in property <float> scene-width: 3200;
    in property <float> scene-height: 2200;
    in property <string> node-metric: "1,000";
    in property <string> primitive-metric: "0";
    in property <string> generation-metric: "0 ms";
    in property <string> frame-metric: "--";
    in-out property <string> project-path: "";
    in property <string> status-title: "Synthetic scene ready";
    in property <string> status-detail: "Choose a project folder to build its index";
    in property <bool> indexing: false;
    in property <bool> paused: false;
    in property <bool> benchmark-active: true;
    in property <string> selected-path: "";
    in property <string> selected-name: "";
    in property <string> selected-kind: "";
    in property <string> selected-size: "";
    in property <string> selected-children: "";
    in property <bool> selection-available: false;
    in property <bool> selection-openable: false;
    in property <bool> selection-pinned: false;
    in property <float> selected-x: 0;
    in property <float> selected-y: 0;
    in property <float> selected-width: 0;
    in property <float> selected-height: 0;
    in-out property <float> zoom: 0.78;
    in-out property <float> pan-x: 0;
    in-out property <float> pan-y: 0;
    in-out property <float> pan-start-x: 0;
    in-out property <float> pan-start-y: 0;
    in-out property <bool> canvas-pan-enabled: true;
    in-out property <bool> canvas-interacting: false;
    in-out property <bool> view-initialized: false;

    callback select-density(int);
    callback browse-project();
    callback open-project(string);
    callback pause-index();
    callback resume-index();
    callback cancel-index();
    callback canvas-clicked(float, float);
    callback canvas-pressed(float, float);
    callback canvas-moved(float, float);
    callback canvas-released(float, float);
    callback open-selected();
    callback pin-selected();
    callback reset-layout();
    callback zoom-in();
    callback zoom-out();

    VerticalBox {
        spacing: 0px;

        Rectangle {
            height: 54px;
            background: #171c22;
            border-color: #29343d;
            border-width: 1px;

            HorizontalBox {
                padding-left: 14px;
                padding-right: 14px;
                spacing: 10px;
                alignment: center;

                Image {
                    width: 30px;
                    height: 30px;
                    source: @image-url("../../../../resouce/shitview.jpg");
                    image-fit: cover;
                }

                VerticalBox {
                    width: 132px;
                    spacing: 1px;
                    alignment: center;
                    Text {
                        text: "shitview";
                        color: #f3f6fb;
                        font-family: "Microsoft YaHei UI";
                        font-size: 16px;
                        font-weight: 700;
                    }
                    Text {
                        text: root.status-title;
                        color: #738696;
                        font-size: 9px;
                        overflow: elide;
                    }
                }

                Rectangle { horizontal-stretch: 1; background: transparent; }

                LineEdit {
                    width: 300px;
                    text: root.project-path;
                    placeholder-text: "Project folder";
                    edited(text) => { root.project-path = text; }
                    accepted(text) => { root.open-project(text); }
                }
                Button { text: "BROWSE"; clicked => { root.browse-project(); } }
                Button { text: "OPEN"; clicked => { root.open-project(root.project-path); } }

                Text {
                    width: 80px;
                    horizontal-alignment: right;
                    text: root.node-metric + " NODES";
                    color: #8192a0;
                    font-size: 10px;
                }
                Button { text: "-"; clicked => { root.zoom-out(); } }
                Text {
                    width: 54px;
                    horizontal-alignment: center;
                    text: round(root.zoom * 100) + "%";
                    color: #c7d2da;
                    font-size: 11px;
                }
                Button { text: "+"; clicked => { root.zoom-in(); } }
            }
        }

        HorizontalBox {
            spacing: 0px;

            Rectangle {
                background: #11161b;
                clip: true;

                canvas := Rectangle {
                    background: #11161b;
                    clip: true;

                    Image {
                        width: canvas.width;
                        height: canvas.height;
                        source: root.graph-image;
                        source-clip-x: round(root.pan-x / max(1, root.scene-width) * self.source.width);
                        source-clip-y: round(root.pan-y / max(1, root.scene-height) * self.source.height);
                        source-clip-width: min(
                            self.source.width - self.source-clip-x,
                            max(1, round(1034 / root.zoom / max(1, root.scene-width) * self.source.width))
                        );
                        source-clip-height: min(
                            self.source.height - self.source-clip-y,
                            max(1, round(746 / root.zoom / max(1, root.scene-height) * self.source.height))
                        );
                        image-fit: fill;
                        cache-rendering-hint: true;
                    }

                    if !root.canvas-interacting || !root.canvas-pan-enabled: Rectangle {
                        cache-rendering-hint: true;
                        for label in root.graph-labels: Rectangle {
                            visible: root.zoom >= 0.30 || label.always-visible;
                            x: (label.x - root.pan-x) * root.zoom * 1px;
                            y: (label.y - root.pan-y) * root.zoom * 1px;
                            width: label.width * root.zoom * 1px;
                            height: max(9px, 24px * root.zoom);
                            Text {
                                width: parent.width;
                                height: parent.height;
                                text: label.text;
                                color: #dbe5ef;
                                font-family: "Microsoft YaHei UI";
                                font-size: max(9px, 13px * root.zoom);
                                font-weight: 600;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }
                    }

                    TouchArea {
                        clicked => {
                            root.canvas-clicked(
                                root.pan-x + self.mouse-x / 1px / root.zoom,
                                root.pan-y + self.mouse-y / 1px / root.zoom
                            );
                        }
                        moved => {
                            if root.canvas-pan-enabled {
                                root.pan-x = max(
                                    0,
                                    min(
                                        max(0, root.scene-width - canvas.width / 1px / root.zoom),
                                        root.pan-start-x - (self.mouse-x - self.pressed-x) / 1px / root.zoom
                                    )
                                );
                                root.pan-y = max(
                                    0,
                                    min(
                                        max(0, root.scene-height - canvas.height / 1px / root.zoom),
                                        root.pan-start-y - (self.mouse-y - self.pressed-y) / 1px / root.zoom
                                    )
                                );
                            } else {
                                root.canvas-moved(
                                    root.pan-x + self.mouse-x / 1px / root.zoom,
                                    root.pan-y + self.mouse-y / 1px / root.zoom
                                );
                            }
                        }
                        pointer-event(event) => {
                            if event.kind == PointerEventKind.down {
                                root.pan-start-x = root.pan-x;
                                root.pan-start-y = root.pan-y;
                                root.canvas-interacting = true;
                                root.canvas-pressed(
                                    root.pan-x + self.mouse-x / 1px / root.zoom,
                                    root.pan-y + self.mouse-y / 1px / root.zoom
                                );
                            } else if event.kind == PointerEventKind.up {
                                root.canvas-interacting = false;
                                root.canvas-released(
                                    root.pan-x + self.mouse-x / 1px / root.zoom,
                                    root.pan-y + self.mouse-y / 1px / root.zoom
                                );
                            } else if event.kind == PointerEventKind.cancel {
                                root.canvas-interacting = false;
                                root.canvas-pan-enabled = true;
                            }
                        }
                        scroll-event(event) => {
                            if event.delta-y > 0 {
                                root.zoom = min(1.60, root.zoom + 0.08);
                                return accept;
                            } else if event.delta-y < 0 {
                                root.zoom = max(0.15, root.zoom - 0.08);
                                return accept;
                            }
                            reject
                        }
                    }

                    if root.selection-available: Rectangle {
                        x: (root.selected-x - root.pan-x) * root.zoom * 1px;
                        y: (root.selected-y - root.pan-y) * root.zoom * 1px;
                        width: root.selected-width * root.zoom * 1px;
                        height: root.selected-height * root.zoom * 1px;
                        background: root.canvas-interacting && !root.canvas-pan-enabled ? #19372d : transparent;
                        border-color: root.canvas-interacting && !root.canvas-pan-enabled ? #63e3a0 : #f0c96b;
                        border-width: 2px;
                        border-radius: 3px;

                        if root.canvas-interacting && !root.canvas-pan-enabled: Text {
                            x: 7px;
                            width: parent.width - 12px;
                            height: parent.height;
                            vertical-alignment: center;
                            text: root.selected-name;
                            color: #e8fff2;
                            font-family: "Microsoft YaHei UI";
                            font-size: max(9px, 12px * root.zoom);
                            overflow: elide;
                        }
                    }

                    minimap := Rectangle {
                        x: 14px;
                        y: canvas.height - self.height - 14px;
                        width: 190px;
                        height: 126px;
                        background: #111820e8;
                        border-color: #3b4b55;
                        border-width: 1px;
                        border-radius: 4px;
                        clip: true;

                        Image {
                            x: 4px;
                            y: 4px;
                            width: parent.width - 8px;
                            height: parent.height - 8px;
                            source: root.graph-image;
                            image-fit: fill;
                            opacity: 0.78;
                            cache-rendering-hint: true;
                        }

                        Rectangle {
                            x: 4px + root.pan-x / max(1, root.scene-width) * (minimap.width - 8px);
                            y: 4px + root.pan-y / max(1, root.scene-height) * (minimap.height - 8px);
                            width: max(
                                8px,
                                min(
                                    minimap.width - 8px,
                                    canvas.width / 1px / root.zoom / max(1, root.scene-width) * (minimap.width - 8px)
                                )
                            );
                            height: max(
                                8px,
                                min(
                                    minimap.height - 8px,
                                    canvas.height / 1px / root.zoom / max(1, root.scene-height) * (minimap.height - 8px)
                                )
                            );
                            background: #62dda018;
                            border-color: #7ce6b2;
                            border-width: 1px;
                            border-radius: 2px;
                        }

                        TouchArea {
                            clicked => {
                                root.pan-x = max(
                                    0,
                                    min(
                                        max(0, root.scene-width - canvas.width / 1px / root.zoom),
                                        self.mouse-x / minimap.width * root.scene-width - canvas.width / 1px / root.zoom / 2
                                    )
                                );
                                root.pan-y = max(
                                    0,
                                    min(
                                        max(0, root.scene-height - canvas.height / 1px / root.zoom),
                                        self.mouse-y / minimap.height * root.scene-height - canvas.height / 1px / root.zoom / 2
                                    )
                                );
                            }
                            moved => {
                                root.pan-x = max(
                                    0,
                                    min(
                                        max(0, root.scene-width - canvas.width / 1px / root.zoom),
                                        self.mouse-x / minimap.width * root.scene-width - canvas.width / 1px / root.zoom / 2
                                    )
                                );
                                root.pan-y = max(
                                    0,
                                    min(
                                        max(0, root.scene-height - canvas.height / 1px / root.zoom),
                                        self.mouse-y / minimap.height * root.scene-height - canvas.height / 1px / root.zoom / 2
                                    )
                                );
                            }
                        }
                    }
                }
            }

            Rectangle {
                width: 246px;
                background: #161b21;
                border-color: #29343d;
                border-width: 1px;

                VerticalBox {
                    padding: 16px;
                    spacing: 12px;
                    Text { text: "STATUS"; color: #748694; font-size: 10px; font-weight: 700; }
                    HorizontalBox {
                        spacing: 8px;
                        Rectangle { width: 6px; height: 6px; border-radius: 3px; background: #55dfa0; }
                        Text { text: root.status-title; color: #c8d4dc; font-size: 11px; overflow: elide; }
                    }
                    Text { text: root.status-detail; color: #70818e; font-size: 9px; wrap: word-wrap; }
                    if root.indexing: HorizontalBox {
                        spacing: 6px;
                        if !root.paused: Button { text: "PAUSE"; clicked => { root.pause-index(); } }
                        if root.paused: Button { text: "RESUME"; clicked => { root.resume-index(); } }
                        Button { text: "CANCEL"; clicked => { root.cancel-index(); } }
                    }
                    Rectangle { height: 1px; background: #29343d; }
                    Text { text: "INSPECTOR"; color: #748694; font-size: 10px; font-weight: 700; }
                    if root.selection-available: VerticalBox {
                        spacing: 9px;
                        Text { text: root.selected-name; color: #edf3f7; font-size: 15px; font-weight: 700; wrap: word-wrap; }
                        Rectangle { height: 1px; background: #29343d; }
                        Text { text: root.selected-kind; color: #64dca0; font-size: 11px; }
                        Text { text: root.selected-size; color: #a6b3bc; font-size: 11px; }
                        Text { text: root.selected-children; color: #a6b3bc; font-size: 11px; }
                        Text { text: root.selected-path; color: #7c8d99; font-size: 10px; wrap: word-wrap; }
                        if root.selection-openable: Button {
                            text: "OPEN SOURCE";
                            clicked => { root.open-selected(); }
                        }
                        if !root.selection-pinned: Button {
                            text: "PIN POSITION";
                            clicked => { root.pin-selected(); }
                        }
                        if root.selection-pinned: Button {
                            text: "UNPIN POSITION";
                            clicked => { root.pin-selected(); }
                        }
                    }
                    if !root.selection-available: Text {
                        text: "Select a file or folder";
                        color: #71828f;
                        font-size: 11px;
                        wrap: word-wrap;
                    }
                    Rectangle { vertical-stretch: 1; background: transparent; }
                    Button { text: "RESET LAYOUT"; clicked => { root.reset-layout(); } }
                }
            }
        }
    }
}
