import { Button, HorizontalBox, LineEdit, VerticalBox } from "std-widgets.slint";

export struct SceneRect {
    x: float,
    y: float,
    width: float,
    height: float,
    fill: color,
    border: color,
}

export struct SceneSegment {
    x: float,
    y: float,
    width: float,
    height: float,
    color: color,
}

export struct SceneLabel {
    x: float,
    y: float,
    width: float,
    text: string,
}

export component AppWindow inherits Window {
    title: "shitview";
    preferred-width: 1280px;
    preferred-height: 800px;
    min-width: 960px;
    min-height: 640px;
    background: #101814;

    in property <[SceneRect]> graph-nodes;
    in property <[SceneRect]> graph-modules;
    in property <[SceneSegment]> graph-segments;
    in property <[SceneLabel]> graph-labels;
    in property <image> graph-image;
    in property <float> scene-width: 3200;
    in property <float> scene-height: 2200;
    in property <string> node-metric: "1,000";
    in property <string> primitive-metric: "0";
    in property <string> generation-metric: "0 ms";
    in property <string> frame-metric: "--";
    in-out property <string> project-path: "";
    in property <string> status-title: "Synthetic scene ready";
    in property <string> status-detail: "Choose a project folder to build its index";
    in property <bool> indexing: false;
    in property <bool> paused: false;
    in property <bool> benchmark-active: true;
    in property <string> selected-path: "";
    in property <string> selected-name: "";
    in property <string> selected-kind: "";
    in property <string> selected-size: "";
    in property <string> selected-children: "";
    in property <bool> selection-available: false;
    in property <bool> selection-openable: false;
    in property <bool> selection-pinned: false;
    in property <float> selected-x: 0;
    in property <float> selected-y: 0;
    in property <float> selected-width: 0;
    in property <float> selected-height: 0;
    in-out property <float> zoom: 0.72;
    in-out property <float> pan-x: 0;
    in-out property <float> pan-y: 0;
    in-out property <float> pan-start-x: 0;
    in-out property <float> pan-start-y: 0;
    in-out property <bool> canvas-pan-enabled: true;
    in-out property <bool> canvas-interacting: false;

    callback select-density(int);
    callback browse-project();
    callback open-project(string);
    callback pause-index();
    callback resume-index();
    callback cancel-index();
    callback canvas-clicked(float, float);
    callback canvas-pressed(float, float);
    callback canvas-moved(float, float);
    callback canvas-released(float, float);
    callback open-selected();
    callback pin-selected();
    callback reset-layout();
    callback zoom-in();
    callback zoom-out();

    VerticalBox {
        spacing: 0px;

        Rectangle {
            height: 62px;
            background: #17201c;
            border-color: #31463c;
            border-width: 1px;

            HorizontalBox {
                padding-left: 18px;
                padding-right: 18px;
                spacing: 12px;
                alignment: center;

                Image {
                    width: 34px;
                    height: 34px;
                    source: @image-url("../../../../resouce/shitview.jpg");
                    image-fit: cover;
                }

                VerticalBox {
                    width: 168px;
                    spacing: 1px;
                    alignment: center;
                    Text {
                        text: "shitview";
                        color: #f3f6fb;
                        font-family: "Microsoft YaHei UI";
                        font-size: 18px;
                        font-weight: 700;
                    }
                    Text {
                        text: "RUST / SLINT";
                        color: #6f8095;
                        font-size: 10px;
                    }
                }

                Rectangle { horizontal-stretch: 1; background: transparent; }

                LineEdit {
                    width: 340px;
                    text: root.project-path;
                    placeholder-text: "Project folder";
                    edited(text) => { root.project-path = text; }
                    accepted(text) => { root.open-project(text); }
                }
                Button { text: "BROWSE"; clicked => { root.browse-project(); } }
                Button { text: "OPEN"; clicked => { root.open-project(root.project-path); } }

                Text { text: "DENSITY"; color: #718197; font-size: 10px; }
                Button { text: "1K"; clicked => { root.select-density(1000); } }
                Button { text: "5K"; clicked => { root.select-density(5000); } }
                Button { text: "10K"; clicked => { root.select-density(10000); } }

                Rectangle { width: 10px; background: transparent; }
                Button { text: "-"; clicked => { root.zoom-out(); } }
                Text {
                    width: 54px;
                    horizontal-alignment: center;
                    text: round(root.zoom * 100) + "%";
                    color: #c9d3df;
                    font-size: 12px;
                }
                Button { text: "+"; clicked => { root.zoom-in(); } }
            }
        }

        HorizontalBox {
            spacing: 0px;

            Rectangle {
                width: 228px;
                background: #141b18;
                border-color: #2d3d35;
                border-width: 1px;

                VerticalBox {
                    padding: 18px;
                    spacing: 16px;

                    Text { text: "SCENE"; color: #718197; font-size: 10px; font-weight: 700; }

                    VerticalBox {
                        spacing: 4px;
                        Text { text: root.node-metric; color: #f0f5fb; font-size: 30px; font-weight: 700; }
                        Text { text: "visible nodes"; color: #8290a2; font-size: 11px; }
                    }

                    Rectangle { height: 1px; background: #2d3d35; }

                    VerticalBox {
                        spacing: 8px;
                        HorizontalBox {
                            Text { text: "Primitives"; color: #7f8c9d; font-size: 11px; }
                            Rectangle { horizontal-stretch: 1; background: transparent; }
                            Text { text: root.primitive-metric; color: #c7d2df; font-size: 11px; }
                        }
                        HorizontalBox {
                            Text { text: "Generated"; color: #7f8c9d; font-size: 11px; }
                            Rectangle { horizontal-stretch: 1; background: transparent; }
                            Text { text: root.generation-metric; color: #61eaa3; font-size: 11px; }
                        }
                        HorizontalBox {
                            Text { text: "FPS"; color: #7f8c9d; font-size: 11px; }
                            Rectangle { horizontal-stretch: 1; background: transparent; }
                            Text { text: root.frame-metric; color: #61eaa3; font-size: 11px; }
                        }
                    }

                    Rectangle { height: 1px; background: #2d3d35; }

                    VerticalBox {
                        spacing: 8px;
                        Text { text: "INDEX"; color: #718197; font-size: 10px; font-weight: 700; }
                        Text { text: root.status-title; color: #d3dbe5; font-size: 12px; }
                        Text { text: root.status-detail; color: #798697; font-size: 10px; wrap: word-wrap; }
                        HorizontalBox {
                            spacing: 6px;
                            if root.indexing && !root.paused: Button {
                                text: "PAUSE";
                                clicked => { root.pause-index(); }
                            }
                            if root.indexing && root.paused: Button {
                                text: "RESUME";
                                clicked => { root.resume-index(); }
                            }
                            if root.indexing: Button {
                                text: "CANCEL";
                                clicked => { root.cancel-index(); }
                            }
                        }
                    }

                    Rectangle { height: 1px; background: #2d3d35; }

                    VerticalBox {
                        spacing: 8px;
                        Text { text: "LAYERS"; color: #718197; font-size: 10px; font-weight: 700; }
                        Text { text: "Structure"; color: #d3dbe5; font-size: 12px; }
                        Text { text: "Dependencies"; color: #798697; font-size: 12px; }
                        Text { text: "Activity"; color: #798697; font-size: 12px; }
                        Text { text: "Labels"; color: #798697; font-size: 12px; }
                    }

                    Button {
                        text: "RESET LAYOUT";
                        clicked => { root.reset-layout(); }
                    }

                    Rectangle { vertical-stretch: 1; background: transparent; }

                    Rectangle {
                        height: 48px;
                        background: #19251f;
                        border-color: #2b6a49;
                        border-width: 1px;
                        border-radius: 5px;
                        HorizontalBox {
                            padding: 10px;
                            spacing: 8px;
                            Rectangle {
                                width: 7px;
                                height: 7px;
                                border-radius: 4px;
                                background: #48e191;
                            }
                            Text { text: root.status-title; color: #9cdbb9; font-size: 11px; }
                        }
                    }
                }
            }

            Rectangle {
                background: #0d1915;
                clip: true;

                canvas := Rectangle {
                    background: #0d1915;
                    clip: true;

                    Image {
                        width: canvas.width;
                        height: canvas.height;
                        source: root.graph-image;
                        source-clip-x: round(root.pan-x / max(1, root.scene-width) * self.source.width);
                        source-clip-y: round(root.pan-y / max(1, root.scene-height) * self.source.height);
                        source-clip-width: min(
                            self.source.width - self.source-clip-x,
                            max(1, round(794 / root.zoom / max(1, root.scene-width) * self.source.width))
                        );
                        source-clip-height: min(
                            self.source.height - self.source-clip-y,
                            max(1, round(738 / root.zoom / max(1, root.scene-height) * self.source.height))
                        );
                        image-fit: fill;
                        cache-rendering-hint: true;
                    }

                    if root.zoom > 0.42 && (!root.canvas-interacting || !root.canvas-pan-enabled): Rectangle {
                        cache-rendering-hint: true;
                        for label in root.graph-labels: Text {
                            x: (label.x - root.pan-x) * root.zoom * 1px;
                            y: (label.y - root.pan-y) * root.zoom * 1px;
                            width: label.width * root.zoom * 1px;
                            height: 28px;
                            text: label.text;
                            color: #dbe5ef;
                            font-family: "Microsoft YaHei UI";
                            font-size: max(9px, 13px * root.zoom);
                            font-weight: 600;
                            overflow: elide;
                        }
                    }

                    TouchArea {
                        clicked => {
                            root.canvas-clicked(
                                root.pan-x + self.mouse-x / 1px / root.zoom,
                                root.pan-y + self.mouse-y / 1px / root.zoom
                            );
                        }
                        moved => {
                            if root.canvas-pan-enabled {
                                root.pan-x = max(
                                    0,
                                    min(
                                        max(0, root.scene-width - canvas.width / 1px / root.zoom),
                                        root.pan-start-x - (self.mouse-x - self.pressed-x) / 1px / root.zoom
                                    )
                                );
                                root.pan-y = max(
                                    0,
                                    min(
                                        max(0, root.scene-height - canvas.height / 1px / root.zoom),
                                        root.pan-start-y - (self.mouse-y - self.pressed-y) / 1px / root.zoom
                                    )
                                );
                            } else {
                                root.canvas-moved(
                                    root.pan-x + self.mouse-x / 1px / root.zoom,
                                    root.pan-y + self.mouse-y / 1px / root.zoom
                                );
                            }
                        }
                        pointer-event(event) => {
                            if event.kind == PointerEventKind.down {
                                root.pan-start-x = root.pan-x;
                                root.pan-start-y = root.pan-y;
                                root.canvas-interacting = true;
                                root.canvas-pressed(
                                    root.pan-x + self.mouse-x / 1px / root.zoom,
                                    root.pan-y + self.mouse-y / 1px / root.zoom
                                );
                            } else if event.kind == PointerEventKind.up {
                                root.canvas-interacting = false;
                                root.canvas-released(
                                    root.pan-x + self.mouse-x / 1px / root.zoom,
                                    root.pan-y + self.mouse-y / 1px / root.zoom
                                );
                            } else if event.kind == PointerEventKind.cancel {
                                root.canvas-interacting = false;
                                root.canvas-pan-enabled = true;
                            }
                        }
                        scroll-event(event) => {
                            if event.delta-y > 0 {
                                root.zoom = min(1.60, root.zoom + 0.08);
                                return accept;
                            } else if event.delta-y < 0 {
                                root.zoom = max(0.28, root.zoom - 0.08);
                                return accept;
                            }
                            reject
                        }
                    }

                    if root.selection-available: Rectangle {
                        x: (root.selected-x - root.pan-x) * root.zoom * 1px;
                        y: (root.selected-y - root.pan-y) * root.zoom * 1px;
                        width: root.selected-width * root.zoom * 1px;
                        height: root.selected-height * root.zoom * 1px;
                        background: root.canvas-interacting && !root.canvas-pan-enabled ? #19372d : transparent;
                        border-color: root.canvas-interacting && !root.canvas-pan-enabled ? #63e3a0 : #f0c96b;
                        border-width: 2px;
                        border-radius: 3px;

                        if root.canvas-interacting && !root.canvas-pan-enabled: Text {
                            x: 7px;
                            width: parent.width - 12px;
                            height: parent.height;
                            vertical-alignment: center;
                            text: root.selected-name;
                            color: #e8fff2;
                            font-family: "Microsoft YaHei UI";
                            font-size: max(9px, 12px * root.zoom);
                            overflow: elide;
                        }
                    }
                }
            }

            Rectangle {
                width: 258px;
                background: #141b18;
                border-color: #2d3d35;
                border-width: 1px;

                VerticalBox {
                    padding: 18px;
                    spacing: 12px;
                    Text { text: "INSPECTOR"; color: #718197; font-size: 10px; font-weight: 700; }
                    if root.selection-available: VerticalBox {
                        spacing: 9px;
                        Text { text: root.selected-name; color: #edf6f0; font-size: 16px; font-weight: 700; wrap: word-wrap; }
                        Rectangle { height: 1px; background: #2d3d35; }
                        Text { text: root.selected-kind; color: #68d89a; font-size: 11px; }
                        Text { text: root.selected-size; color: #aab8b1; font-size: 11px; }
                        Text { text: root.selected-children; color: #aab8b1; font-size: 11px; }
                        Text { text: root.selected-path; color: #82928a; font-size: 10px; wrap: word-wrap; }
                        if root.selection-openable: Button {
                            text: "OPEN SOURCE";
                            clicked => { root.open-selected(); }
                        }
                        if !root.selection-pinned: Button {
                            text: "PIN POSITION";
                            clicked => { root.pin-selected(); }
                        }
                        if root.selection-pinned: Button {
                            text: "UNPIN POSITION";
                            clicked => { root.pin-selected(); }
                        }
                    }
                    if !root.selection-available: Text {
                        text: "Select a component to inspect its path and metadata.";
                        color: #718197;
                        font-size: 11px;
                        wrap: word-wrap;
                    }
                    Rectangle { vertical-stretch: 1; background: transparent; }
                }
            }
        }
    }
}
